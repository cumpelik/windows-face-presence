<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>FacePresence</AssemblyName>
    <RootNamespace>FacePresence</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- umožní build i na Linux/macOS (bez spuštění) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- single-file publish: dotnet publish -c Release -r win-x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\FacePresence.ico</ApplicationIcon>
    <Product>Face Presence</Product>
    <Description>Keeps Windows unlocked while the enrolled user is in front of the camera; locks normally otherwise.</Description>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\FacePresence.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\tray_*.ico" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\flag_*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modely z OpenCV Zoo: YuNet (detekce, MIT) a SFace (embedding, Apache-2.0) -->
    <EmbeddedResource Include="Models\face_detection_yunet_2023mar.onnx" LogicalName="yunet.onnx" />
    <EmbeddedResource Include="Models\face_recognition_sface_2021dec.onnx" LogicalName="sface.onnx" />
  </ItemGroup>

</Project>
