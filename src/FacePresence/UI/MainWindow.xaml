<ui:FluentWindow x:Class="FacePresence.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FacePresence.Localization"
                 Title="Face Presence"
                 Width="1060" Height="760" MinWidth="920" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Buttons get a clear outline so they don't blend into the cards (which have none). -->
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Style.Triggers>
                <Trigger Property="Appearance" Value="Primary">
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Face Presence" />

        <!-- ===== Status hero ===== -->
        <ui:Card Grid.Row="1" Margin="16,4,16,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="56" Height="56" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StateCircle" Fill="#6E6E6E" />
                    <ui:SymbolIcon x:Name="StateSymbol" Symbol="ArrowSync24" Filled="True" FontSize="28" Foreground="White" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StateTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StateMessage" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="FlagEn" Width="27" Height="18" Margin="0,0,8,0" Cursor="Hand" ToolTip="English" MouseLeftButtonUp="FlagEn_Click" />
                    <Image x:Name="FlagCs" Width="27" Height="18" Margin="0,0,16,0" Cursor="Hand" ToolTip="Čeština" MouseLeftButtonUp="FlagCs_Click" />
                    <ui:Button x:Name="PauseButton" Click="PauseButton_Click" MinWidth="120">
                        <ui:Button.Icon>
                            <ui:SymbolIcon x:Name="PauseIcon" Symbol="Pause24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <!-- stats: fixed equal columns, values change but nothing jumps -->
                <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="6" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatCaption}" Text="{Binding [stat.score], Source={x:Static loc:Loc.I}}" />
                        <TextBlock x:Name="StatScore" Style="{StaticResource StatValue}" Text="–" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatCaption}" Text="{Binding [stat.idle], Source={x:Static loc:Loc.I}}" />
                        <TextBlock x:Name="StatIdle" Style="{StaticResource StatValue}" Text="–" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatCaption}" Text="{Binding [stat.next], Source={x:Static loc:Loc.I}}" />
                        <TextBlock x:Name="StatNext" Style="{StaticResource StatValue}" Text="–" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatCaption}" Text="{Binding [stat.lock], Source={x:Static loc:Loc.I}}" />
                        <TextBlock x:Name="StatLock" Style="{StaticResource StatValue}" Text="–" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatCaption}" Text="{Binding [stat.inputs], Source={x:Static loc:Loc.I}}" />
                        <TextBlock x:Name="StatInputs" Style="{StaticResource StatValue}" Text="–" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatCaption}" Text="{Binding [stat.camera], Source={x:Static loc:Loc.I}}" />
                        <TextBlock x:Name="StatCamera" Style="{StaticResource StatValue}" Text="–" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </ui:Card>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- left: preview, camera, tools -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border CornerRadius="8" Background="#FF101216">
                    <Grid>
                        <TextBlock x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#99FFFFFF"
                                   Text="{Binding [preview.waiting], Source={x:Static loc:Loc.I}}" />
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush x:Name="PreviewBrush" Stretch="Uniform" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <ui:Card Grid.Row="1" Margin="0,12,0,0" Padding="18,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [card.camera], Source={x:Static loc:Loc.I}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CameraCombo" SelectionChanged="CameraCombo_SelectionChanged" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Click="Refresh_Click" Content="{Binding [btn.refresh], Source={x:Static loc:Loc.I}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [hint.camera], Source={x:Static loc:Loc.I}}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="18,12">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Click="About_Click" Content="{Binding [btn.about], Source={x:Static loc:Loc.I}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Info24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="4,0" HorizontalAlignment="Stretch" Click="DataFolder_Click" Content="{Binding [btn.data_folder], Source={x:Static loc:Loc.I}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="Diagnostics_Click" Content="{Binding [btn.diagnostics], Source={x:Static loc:Loc.I}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Stethoscope24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [hint.app], Source={x:Static loc:Loc.I}}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- right: settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:Card Padding="18,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [card.enroll], Source={x:Static loc:Loc.I}}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="EnrollIcon" Symbol="CheckmarkCircle24" Filled="True" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock x:Name="EnrollStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="EnrollButton" Click="Enroll_Click" Appearance="Primary" MinWidth="150">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PersonAdd24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="ClearButton" Margin="8,0,0,0" Click="Clear_Click" Content="{Binding [btn.clear], Source={x:Static loc:Loc.I}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [hint.enroll], Source={x:Static loc:Loc.I}}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0" Padding="18,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [card.presence], Source={x:Static loc:Loc.I}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding [lbl.present_interval], Source={x:Static loc:Loc.I}}" />
                                <ui:NumberBox x:Name="PresentBox" Grid.Column="1" Minimum="0.5" Maximum="300" SmallChange="1" LargeChange="10" MaxDecimalPlaces="1" ClearButtonEnabled="False" />
                                <TextBlock Grid.Row="2" Style="{StaticResource SettingLabel}" Text="{Binding [lbl.absent_interval], Source={x:Static loc:Loc.I}}" />
                                <ui:NumberBox x:Name="AbsentBox" Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="60" SmallChange="0.5" LargeChange="5" MaxDecimalPlaces="1" ClearButtonEnabled="False" />
                                <TextBlock Grid.Row="4" Style="{StaticResource SettingLabel}" Text="{Binding [lbl.threshold], Source={x:Static loc:Loc.I}}" />
                                <Grid Grid.Row="4" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ThresholdSlider" Minimum="0.2" Maximum="0.8" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Threshold_Changed" />
                                    <TextBlock x:Name="ThresholdText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding [hint.threshold], Source={x:Static loc:Loc.I}}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0" Padding="18,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [card.app], Source={x:Static loc:Loc.I}}" />
                            <ui:ToggleSwitch x:Name="AutostartSwitch" Content="{Binding [chk.autostart], Source={x:Static loc:Loc.I}}"
                                             Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Footer ===== -->
        <TextBlock Grid.Row="3" Margin="16,10,16,10" HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run x:Name="FooterPart1" /><Hyperlink NavigateUri="https://claude.ai" RequestNavigate="Link_RequestNavigate"><Run x:Name="FooterClaude" /></Hyperlink><Run x:Name="FooterPart2" /><Hyperlink NavigateUri="https://tabidoo.cloud" RequestNavigate="Link_RequestNavigate"><Run x:Name="FooterTabidoo" /></Hyperlink><Run x:Name="FooterPart3" />
        </TextBlock>
    </Grid>
</ui:FluentWindow>
