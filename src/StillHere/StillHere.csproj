<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StillHere</AssemblyName>
    <RootNamespace>StillHere</RootNamespace>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- allows building on Linux/macOS too (running requires Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- One EXE with the .NET runtime inside (no runtime install needed), compressed:
         dotnet publish -c Release -r win-x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WFAC010: the WinForms analyzer wants DPI in code; this is a WPF app, the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>Assets\StillHere.ico</ApplicationIcon>
    <Product>Still Here</Product>
    <Description>Keeps Windows unlocked while the enrolled user is in front of the camera; locks normally otherwise.</Description>
    <Authors>Michal Cumpelik</Authors>
    <Copyright>Copyright (c) 2026 Michal Cumpelik. MIT License.</Copyright>
    <PackageProjectUrl>https://github.com/cumpelik/windows-still-here</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cumpelik/windows-still-here</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF and WinForms types share names (Application, Button, Color, …); WinForms is imported explicitly where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF projects drop System.IO from implicit usings; the non-UI code uses it everywhere. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\StillHere.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\StillHere-256.png" LogicalName="app.png" />
    <EmbeddedResource Include="Assets\tray_*.ico" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\flag_*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- OpenCvSharp4.runtime.win ships the FFmpeg plugin (LGPL, 28 MB). Video I/O is not used, so it is excluded. -->
  <Target Name="ExcludeOpenCvFfmpeg" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>

  <!--
    Release signing (only when build.ps1 passes SignFilesScript): native libraries are extracted from the single-file
    bundle to %TEMP% at run time and Smart App Control blocks unsigned ones (OpenCvSharpExtern.dll). So copies of the
    bundled .dll/.exe files are signed (only the unsigned ones) and bundled instead of the originals.
  -->
  <Target Name="SignFilesToBundle" AfterTargets="PrepareForBundle" BeforeTargets="_GenerateSingleFileBundleInputCache"
          Condition="'$(PublishSingleFile)' == 'true' and '$(SignFilesScript)' != ''">
    <PropertyGroup>
      <_SignDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)signed</_SignDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Not the host itself (StillHere.exe): the bundle is appended to it, so it is signed only at the very end. -->
      <_FilesToSign Include="@(FilesToBundle)" Condition="('%(Extension)' == '.dll' or '%(Extension)' == '.exe') and '%(RelativePath)' != '$(PublishedSingleFileName)'" />
    </ItemGroup>
    <RemoveDir Directories="$(_SignDir)" />
    <Copy SourceFiles="@(_FilesToSign)" DestinationFiles="@(_FilesToSign->'$(_SignDir)\%(RelativePath)')" />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(SignFilesScript)&quot; -Path &quot;$(_SignDir)&quot; -SignTool &quot;$(SignToolExe)&quot; -Dlib &quot;$(SignDlib)&quot; -Metadata &quot;$(SignMetadata)&quot;" />
    <ItemGroup>
      <FilesToBundle Remove="@(_FilesToSign)" />
      <FilesToBundle Include="@(_FilesToSign->'$(_SignDir)\%(RelativePath)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Models from the OpenCV Zoo: YuNet (detection, MIT) and SFace (embedding, Apache-2.0) -->
    <EmbeddedResource Include="Models\face_detection_yunet_2023mar.onnx" LogicalName="yunet.onnx" />
    <EmbeddedResource Include="Models\face_recognition_sface_2021dec.onnx" LogicalName="sface.onnx" />
  </ItemGroup>

</Project>
